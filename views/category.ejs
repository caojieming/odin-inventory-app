<html>
  <head>
    <!-- set styling file -->
    <link rel="stylesheet" href="/styles.css">
    <title>Category - <%= category_name %></title>
  </head>
  <body>
    <a href="/"><button>Back</button></a>

    <h1><%= category_name %></h1>

    <a href="/<%= category_name %>/itemForm"><button>Add new item</button></a>

    <% for (let i = 0; i < items.length; i++) { 
      curItem = items[i]; %>
      <p>
        <form method="POST" action="/deleteItem/<%= category_name %>/<%= curItem.item_name %>">
          <button class="delete-btn">X</button>
        </form>

        <a href="/category/<%= category_name %>/item/<%= curItem.item_name %>" ><button><%= curItem.item_name %></button></a>
        <%= `Stock: ${curItem.stock}` %>
        <%= `Description: ${curItem.description}` %>
      </p>
    <% } %>
    
    <%- include('./partials/footer') %>
  </body>
</html>