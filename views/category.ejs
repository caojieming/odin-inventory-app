<html>
  <head>
    <!-- set styling file -->
    <link rel="stylesheet" href="/css/base.css">
    <title>Category - <%= category.name %></title>
  </head>
  <body>
    <main>
      <a href="/"><button>Back to Home</button></a>

      <h1><%= category.name %></h1>

      <h3><%= `Description: ${category.description}` %></h3>

      <a href="/category/<%= category.name %>/categoryItemForm"><button>Add an existing item to <%= category.name %></button></a>

      <a href="/category/<%= category.name %>/itemForm"><button>Create a new item and add it to <%= category.name %></button></a>

      <div class="list">
        <% for (let i = 0; i < items.length; i++) { 
          curItem = items[i]; %>
          <div class="item">
            <form method="POST" action="/deleteCategoryItem/<%= category.name %>/<%= curItem.item_name %>">
              <button class="delete-btn">Remove</button>
            </form>

            <a href="/category/<%= category.name %>/item/<%= curItem.item_name %>" ><button><%= curItem.item_name %></button></a>
            <p><%= `Stock: ${curItem.stock}` %></p>
            <p><%= `Description: ${curItem.description}` %></p>
          </div>
        <% } %>
      </div>
    </main>
    
    <%- include('./partials/footer') %>
  </body>
</html>