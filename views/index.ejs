<html>
  <head>
    <!-- set styling file -->
    <link rel="stylesheet" href="/styles.css">
    <title>Homepage</title>
  </head>
  <body>
    <h1>Inventory - Categories</h1>

    <a href="/new"><button>Add new message</button></a>

    <% for (let i = 0; i < categories.length; i++) { 
      curCat = categories[i]; %>
      <p>
        <button>X</button>
        <button><%= curCat.name %></button>
        <%= `Description: ${curCat.description}` %>
      </p>
    <% } %>

    <%- include('./partials/footer') %>
  </body>
</html>