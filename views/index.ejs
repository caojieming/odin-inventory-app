<html>
  <head>
    <!-- set styling file -->
    <link rel="stylesheet" href="/styles.css">
    <title>Homepage</title>
  </head>
  <body>
    <h1>Inventory - Categories</h1>

    <a href="/categoryForm"><button>Add new category</button></a>

    <% for (let i = 0; i < categories.length; i++) { 
      curCat = categories[i]; %>
      <p>
        <form method="POST" action="/deleteCategory/<%= curCat.name %>">
          <button class="delete-btn">X</button>
        </form>
        <a href="/<%= curCat.name %>" ><button><%= curCat.name %></button></a>
        <%= `Description: ${curCat.description}` %>
      </p>
    <% } %>


    <h1>Inventory - Items</h1>

    <a href="/"><button>Add new item</button></a>

    <% for (let i = 0; i < items.length; i++) { 
      curItem = items[i]; %>
      <p>
        <!-- /deleteItem/<%= curItem.name %> not implemented yet -->
        <form method="POST" action="/deleteItem/<%= curItem.name %>">
          <button class="delete-btn">X</button>
        </form>
        <a href="/item/<%= curItem.name %>" ><button><%= curItem.name %></button></a>
        <%= `Description: ${curItem.description}` %>
        <%= `Description: ${curItem.stock}` %>
      </p>
    <% } %>

    <%- include('./partials/footer') %>
  </body>
</html>