<html>
  <head>
    <!-- set styling file -->
    <link rel="stylesheet" href="/css/base.css">
    <title>New Item</title>
  </head>
  <body>
    <a href="<%= category_name ? `/category/${category_name}` : '/' %>"><button>Back</button></a>

    <h1>Create new Item!</h1>

    <%- include("partials/errors.ejs") %>
    
    <form method="POST" action="<%= category_name ? `/category/${category_name}/itemForm` : '/itemForm' %>">
      <input name="name" type="text" placeholder="Put item name here!">
      <input name="description" type="text" placeholder="Put item description here!">
      <input name="stock" type="text" placeholder="Put stock here!">
      <button>Submit</button>
    </form>
    
    <%- include('./partials/footer') %>
  </body>
</html>