<html>
  <head>
    <!-- set styling file -->
    <link rel="stylesheet" href="/styles.css">
    <title>New Category</title>
  </head>
  <body>
    <a href="/"><button>Back to Categories</button></a>

    <h1>Add new category!</h1>

    <%- include("partials/errors.ejs") %>
    
    <form method="POST" action="/categoryForm">
      <input name="name" type="text" placeholder="Put category name here!">
      <input name="description" type="text" placeholder="Put category description here!">
      <button>Submit</button>
    </form>
    
    <%- include('./partials/footer') %>
  </body>
</html>