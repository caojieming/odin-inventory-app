<html>
  <head>
    <!-- set styling file -->
    <link rel="stylesheet" href="/styles.css">
    <title>Item Details</title>
  </head>
  <body>
    <a href="../"><button>Back to Category: <%= category_name %></button></a>

    <h1><%= item.name %></h1>

    <p>Description: <%= item.description %></p>
    <p>Stock: <%= item.stock %></p>
    <!-- TODO: add a list of other categories this item is in -->

    <form action="/delete/category/<%= category_name %>/item/<%= item.name %>" method="post">
      <button class="delete-btn" type="submit">Delete item from category</button>
    </form>
    
    <%- include('./partials/footer') %>
  </body>
</html>